      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "text": {
      "type": "richtext"
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "videoUrl": {
      "type": "string",
      "required": false
    }
  }
}
